#!/bin/sh
# rust_serial local workspace pre-commit hook.

set -eu

echo ""
echo "========================================"
echo "  Rust workspace pre-commit check"
echo "========================================"
echo ""

echo ">>> [1/3] cargo fmt --all -- --check"
cargo fmt --all -- --check
echo "  OK: formatting passed"

echo ">>> [2/3] cargo clippy --workspace --all-targets -- -D warnings"
cargo clippy --workspace --all-targets -- -D warnings
echo "  OK: clippy passed"

echo ">>> [3/3] cargo test --workspace"
cargo test --workspace
echo "  OK: tests passed"

echo ""
echo "========================================"
echo "  All checks passed. Commit allowed."
echo "========================================"
echo ""
